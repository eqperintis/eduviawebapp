# --- Database (MySQL/MariaDB) ---
# On Hostinger the app connects to the database on the same server:
#   mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE
# Tables are created by the app itself on start-up (src/lib/migrate.ts).
DATABASE_URL=""

# --- Sessions --- (openssl rand -base64 32)
SESSION_SECRET=""

# --- First admin --- used once, when the database has no users yet.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Public address --- used in endpoint URLs, snippets and email links.
APP_URL="https://marketing.eduvia.my"

# --- Cron --- shared secret for GET /api/cron/automations?secret=...
CRON_SECRET=""

TZ="Asia/Kuala_Lumpur"

# --- Email (notifications and automation emails) ---
# resend:    EMAIL_API_KEY = Resend API key, EMAIL_FROM on a verified domain
# gmail:     EMAIL_API_KEY = 16-character Google App Password
# hostinger: EMAIL_API_KEY = the mailbox password, EMAIL_FROM = the mailbox
# Left unset, submissions are still saved; emails are skipped and logged.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="Eduvia"

# --- Google Sheets step (same setup as SEKOOL) ---
# OAuth client (Web application) with redirect URI <APP_URL>/api/google/callback,
# and an API key with the Google Picker API enabled.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_PICKER_API_KEY=""
