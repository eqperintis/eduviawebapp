# --- Database (MySQL/MariaDB) ---
# On Hostinger the app connects to the database on the same server. Use
# 127.0.0.1, not localhost:
#   mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE
# Tables are created by the app itself on start-up (src/lib/migrate.ts).
DATABASE_URL=""

# --- Sessions --- (openssl rand -base64 32)
SESSION_SECRET=""

# --- First admin --- used once, when the database has no users yet.
ADMIN_EMAIL="eqperintis.a@gmail.com"
ADMIN_PASSWORD=""

# --- Public address --- used in endpoint URLs, snippets and email links.
APP_URL="https://marketing.eduvia.my"

# --- Cron --- shared secret for GET /api/cron/automations?secret=...
CRON_SECRET=""

TZ="Asia/Kuala_Lumpur"

# --- Email (notifications, automation emails, password resets) ---
# Sent from the Gmail account through Gmail's SMTP. EMAIL_API_KEY is a
# 16-character Google App Password (not the account password). See
# docs/SETUP.md, step 4.
# Left unset, submissions are still saved; emails are skipped and logged.
EMAIL_PROVIDER="gmail"
EMAIL_FROM="eqperintis.a@gmail.com"
EMAIL_FROM_NAME="Eduvia"
EMAIL_API_KEY=""
# Other providers still work: resend | hostinger (SMTP, mailbox password in
# EMAIL_API_KEY) | hostinger_api (HOSTINGER_MAIL_TOKEN, HOSTINGER_MAILBOX_ID).

# --- Google Sheets step --- see docs/SETUP.md
# OAuth client (Web application) with redirect URI <APP_URL>/api/google/callback,
# and an API key restricted to the Google Picker API.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_PICKER_API_KEY=""
